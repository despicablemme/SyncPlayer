{
  "name": "syncplay-desktop",
  "version": "0.7.0",
  "description": "SyncPlay Desktop App - 异地同步看片神器 (独立打包)",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test ../test/unit/*.test.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "prebuild": "node prebuild.js"
  },
  "keywords": [
    "webrtc",
    "video-sync",
    "p2p",
    "electron"
  ],
  "author": "Bruce",
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bruce.syncplay",
    "productName": "SyncPlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "public/**/*.js"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*",
      "src/server/**",
      "public/**/*.wasm"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Video"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "electron-store": "^8.2.0",
    "hls.js": "^1.6.16",
    "peer": "^0.6.1"
  }
}
